{% assign category_index = 0 %}
<section class="hero-grid" aria-label="Shop by category">
  <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" class="hero-grid__main"><div class="hero-grid__main-deco" aria-hidden="true">{% for i in (1..8) %}<span class="hero-grid__bubble hero-grid__bubble--{{ i }}"></span>{% endfor %}{% for i in (1..5) %}<span class="hero-grid__confetti hero-grid__confetti--{{ i }}"></span>{% endfor %}</div><div class="hero-grid__main-pathway" aria-hidden="true"><svg class="hero-grid__pathway-svg" viewBox="0 0 1440 200" preserveAspectRatio="none"><defs><linearGradient id="hero-pathway-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#82c4ff"/><stop offset="100%" stop-color="#5eb0ff"/></linearGradient></defs><path d="M0,72 C280,148 520,28 760,88 C1000,148 1220,42 1440,78 L1440,200 L0,200 Z" fill="url(#hero-pathway-grad)"/><path d="M0,88 C280,152 520,48 760,100 C1000,152 1220,58 1440,92" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="5"/></svg></div><div class="hero-grid__main-inner"><div class="hero-grid__main-copy"><h1 class="hero-grid__main-title">{{ section.settings.heading | default: 'Opening Soon!' | escape }}</h1><p class="hero-grid__main-lede">{{ section.settings.text | default: "We're coming soon. Straight from our store to your door." | escape }}</p><span class="hero-grid__main-cta">{{ section.settings.button_label | default: 'Shop now' | escape }}</span></div><div class="hero-grid__main-visual"><img src="{{ 'playing-pets.png' | asset_url }}" alt="" width="600" height="600"></div></div></a>
  <div class="hero-grid__featured"><div class="hero-grid__container"><ul class="hero-grid__categories" role="list">{% for block in section.blocks %}{% if block.type == 'category' %}{% assign category_index = category_index | plus: 1 %}{% assign collection_handle = block.settings.title | handle %}{% assign destination_collection = block.settings.collection %}{% if destination_collection == blank %}{% assign destination_collection = collections[collection_handle] %}{% endif %}{% capture fallback_image %}{% case category_index %}{% when 1 %}dog-fetch.webp{% when 2 %}dog-chew.webp{% when 3 %}dog-plush.webp{% when 4 %}dog-puzzle.webp{% when 5 %}cat-catnip.webp{% when 6 %}cat-interactive.webp{% when 7 %}cat-scratch.webp{% else %}cat-tease.webp{% endcase %}{% endcapture %}<li class="hero-grid__category" {{ block.shopify_attributes }}><a href="{{ destination_collection.url | default: routes.all_products_collection_url }}" class="hero-grid__category-card hero-grid__category-card--{{ block.settings.accent | default: 'blue' }}"><span class="hero-grid__category-media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ fallback_image | strip | asset_url }}" alt="" width="400" height="400" loading="lazy">{% endif %}</span><span class="hero-grid__category-title">{{ block.settings.title | escape }}</span></a></li>{% endif %}{% endfor %}</ul><nav class="hero-grid__collection-bars" aria-label="Shop by collection"><ul class="hero-grid__collection-bars-list">{% for block in section.blocks %}{% if block.type == 'collection_link' %}{% assign collection_handle = block.settings.label | handle %}{% assign destination_collection = block.settings.collection %}{% if destination_collection == blank %}{% assign destination_collection = collections[collection_handle] %}{% endif %}<li {{ block.shopify_attributes }}><a href="{{ destination_collection.url | default: routes.all_products_collection_url }}" class="hero-grid__collection-bar">{{ block.settings.label | escape }}</a></li>{% endif %}{% endfor %}</ul></nav></div></div>
</section>
{% schema %}
{"name":"Playtime hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"Opening Soon!"},{"type":"textarea","id":"text","label":"Text","default":"We're coming soon. Straight from our store to your door."},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"shop_link","label":"Shop link"}],"blocks":[{"type":"category","name":"Category card","settings":[{"type":"text","id":"title","label":"Title","default":"Fetch"},{"type":"select","id":"accent","label":"Accent","default":"blue","options":[{"value":"blue","label":"Blue"},{"value":"yellow","label":"Yellow"},{"value":"pink","label":"Pink"},{"value":"teal","label":"Teal"},{"value":"orange","label":"Orange"},{"value":"navy","label":"Navy"}]},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"}]},{"type":"collection_link","name":"Collection bar","settings":[{"type":"text","id":"label","label":"Label","default":"Dog"},{"type":"collection","id":"collection","label":"Collection"}]}],"max_blocks":14,"presets":[{"name":"Playtime hero","blocks":[{"type":"category","settings":{"title":"Fetch","accent":"blue"}},{"type":"category","settings":{"title":"Chew","accent":"yellow"}},{"type":"category","settings":{"title":"Plush","accent":"pink"}},{"type":"category","settings":{"title":"Puzzle","accent":"teal"}},{"type":"category","settings":{"title":"Catnip","accent":"orange"}},{"type":"category","settings":{"title":"Interactive","accent":"navy"}},{"type":"category","settings":{"title":"Scratch","accent":"blue"}},{"type":"category","settings":{"title":"Teaser","accent":"pink"}},{"type":"collection_link","settings":{"label":"Dog"}},{"type":"collection_link","settings":{"label":"Cat"}},{"type":"collection_link","settings":{"label":"Outdoor"}},{"type":"collection_link","settings":{"label":"Solo Play"}},{"type":"collection_link","settings":{"label":"Indoor"}},{"type":"collection_link","settings":{"label":"Interactive"}}]}]}
{% endschema %}
