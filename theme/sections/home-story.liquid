<section class="home-page__story" aria-label="Our story"><div class="home-page__story-deco" aria-hidden="true">{% for i in (1..4) %}<span class="home-page__story-bubble home-page__story-bubble--{{ i }}"></span>{% endfor %}</div><div class="home-page__container"><div class="home-page__story-layout"><div class="home-page__story-visual"><div class="home-page__story-pets"><img class="home-page__story-pet home-page__story-pet--dog" src="{{ 'cartoon_dog_hero.png' | asset_url }}" alt="" width="400" height="600" loading="lazy"><img class="home-page__story-pet home-page__story-pet--cat" src="{{ 'cartoon_cat_hero.png' | asset_url }}" alt="" width="400" height="600" loading="lazy"></div><p class="home-page__story-caption">{{ section.settings.caption | escape }}</p></div><div class="home-page__story-copy"><p class="home-page__story-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="home-page__story-title">{{ section.settings.heading | escape }}</h2><div class="home-page__story-content">{{ section.settings.copy }}</div><blockquote class="home-page__story-promise"><p>{{ section.settings.promise | escape }}</p></blockquote></div></div></div></section>
{% schema %}{"name":"Our story","settings":[{"type":"text","id":"caption","label":"Caption","default":"From our store to your door"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Family owned in Moorpark, CA"},{"type":"text","id":"heading","label":"Heading","default":"Our story"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>I started Playtime Pets with my wife after being on another big buying and selling platform—however I didn't feel like I was connecting with my customers like I wanted to. In the brick-and-mortar store I have a connection with all the customers, and I wanted that to be the experience people get when they shop online with us.</p><p>I felt I could make the online shopping experience as close as possible to being in the store with me. People have questions, they have concerns, and sometimes there is a problem. When any of these occur, people want someone to answer their questions or address any issues—not ignore them.</p>"},{"type":"textarea","id":"promise","label":"Promise","default":"I will always acknowledge your purchase and ship out the next day when possible. We take pride in people having a great experience shopping with us."}],"presets":[{"name":"Our story"}]}{% endschema %}
