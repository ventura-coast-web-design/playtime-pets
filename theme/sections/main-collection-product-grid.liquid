{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="shop-page">
    <div class="shop-page__container"><div class="shop-view shop-view--3"><div class="shop-view__content">
      <div class="shop-view__collection-banner" aria-hidden="true"><span class="shop-view__collection-banner-stripe shop-view__collection-banner-stripe--pink"></span><span class="shop-view__collection-banner-stripe shop-view__collection-banner-stripe--blue"></span><span class="shop-view__collection-banner-stripe shop-view__collection-banner-stripe--yellow"></span><span class="shop-view__collection-banner-stripe shop-view__collection-banner-stripe--teal"></span></div>
      {% assign result_start = paginate.current_offset | plus: 1 %}{% assign result_end = paginate.current_offset | plus: collection.products.size %}{% if paginate.items == 0 %}{% assign result_start = 0 %}{% assign result_end = 0 %}{% endif %}{% assign catalog_total = collection.all_products_count | default: collection.products_count %}
      <header class="shop-view__catalog-toolbar"><p class="shop-view__results-count" aria-live="polite">Showing {{ result_start }}–{{ result_end }} of {{ paginate.items }} products ({{ catalog_total }} total)</p><h1 class="visually-hidden">{{ collection.title | escape }}</h1><form class="shop-view__search" action="{{ routes.search_url }}" method="get" data-server-product-search data-section-id="{{ section.id }}" data-clear-url="{{ collection.url }}"><label class="shop-view__search-label" for="ProductSearch-{{ section.id }}">Search all products</label><div class="shop-view__search-field"><i class="fa-solid fa-magnifying-glass shop-view__search-icon" aria-hidden="true"></i><input id="ProductSearch-{{ section.id }}" class="shop-view__search-input" type="search" name="q" placeholder="Search all products" autocomplete="off"><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><button class="shop-view__search-clear" type="button" data-server-product-search-clear aria-label="Clear product search" hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div></form></header>
      <div class="shop-view__main-layout">
        {% if section.settings.enable_filtering and collection.filters.size > 0 %}
          <div class="shop-filters-panel" data-filter-panel><button class="shop-filters__toggle" type="button" aria-expanded="false" aria-controls="ShopFilters-{{ section.id }}"><span class="shop-filters__toggle-text">Filters</span><span class="shop-filters__toggle-icons" aria-hidden="true"><i class="fa-solid fa-bars shop-filters__icon-bars"></i><i class="fa-solid fa-xmark shop-filters__icon-close"></i></span></button><form id="ShopFilters-{{ section.id }}" class="shop-filters" action="{{ collection.url }}" method="get">
            <h2 class="shop-filters__title">Filter by:</h2>
            {% assign feature_count = 0 %}
            {% capture features %}
              {% for feature_collection in collections %}
                {% if collection.all_tags contains feature_collection.title %}
                  {% assign feature_count = feature_count | plus: 1 %}
                  {% assign remaining_tag_handles = '' %}
                  {% for active_tag in current_tags %}{% unless active_tag == feature_collection.title %}{% if remaining_tag_handles != blank %}{% assign remaining_tag_handles = remaining_tag_handles | append: '+' %}{% endif %}{% assign active_tag_handle = active_tag | handleize %}{% assign remaining_tag_handles = remaining_tag_handles | append: active_tag_handle %}{% endunless %}{% endfor %}
                  {% assign selected_tag_handles = remaining_tag_handles %}{% if selected_tag_handles != blank %}{% assign selected_tag_handles = selected_tag_handles | append: '+' %}{% endif %}{% assign feature_tag_handle = feature_collection.title | handleize %}{% assign selected_tag_handles = selected_tag_handles | append: feature_tag_handle %}
                  <li><label class="shop-filters__value"><input class="shop-filters__input shop-filters__tag-input" type="checkbox" data-tag-url="{{ collection.url }}{% if current_tags contains feature_collection.title %}{% if remaining_tag_handles != blank %}/{{ remaining_tag_handles }}{% endif %}{% else %}/{{ selected_tag_handles }}{% endif %}" {% if current_tags contains feature_collection.title %}checked{% endif %}><span class="shop-filters__value-label">{{ feature_collection.title | escape }}</span><span class="shop-filters__value-count">({{ feature_collection.all_products_count }})</span></label></li>
                {% endif %}
              {% endfor %}
            {% endcapture %}
            {% if feature_count > 0 %}<fieldset class="shop-filters__group"><legend class="shop-filters__legend">Features</legend><ul id="FeatureValues-{{ section.id }}" class="shop-filters__values{% if feature_count > 10 %} shop-filters__values--collapsible{% endif %}" role="list">{{ features }}</ul>{% if feature_count > 10 %}<button class="shop-filters__more" type="button" data-filter-expand="FeatureValues-{{ section.id }}" aria-expanded="false">See more</button>{% endif %}</fieldset>{% endif %}
            {% for filter in collection.filters %}
              {% assign filter_label = filter.label | downcase %}
              {% unless filter_label == 'availability' or filter_label == 'product type' or filter_label == 'category' or filter_label == 'categories' or filter_label == 'tag' or filter_label == 'tags' %}
                <fieldset class="shop-filters__group"><legend class="shop-filters__legend">{% case filter_label %}{% when 'vendor' %}Brand{% when 'collection', 'collections' %}Features{% when 'tag', 'tags' %}Tags{% else %}{{ filter.label | escape }}{% endcase %}</legend>
                  {% case filter.type %}
                    {% when 'boolean', 'list' %}<ul id="FilterValues-{{ section.id }}-{{ forloop.index }}" class="shop-filters__values{% if filter_label == 'vendor' and filter.values.size > 10 %} shop-filters__values--collapsible{% endif %}" role="list">{% for value in filter.values %}<li><label class="shop-filters__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}"><input class="shop-filters__input" type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" onchange="this.form.submit()" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span class="shop-filters__value-label">{{ value.label | escape }}</span><span class="shop-filters__value-count">({{ value.count }})</span></label></li>{% endfor %}</ul>{% if filter_label == 'vendor' and filter.values.size > 10 %}<button class="shop-filters__more" type="button" data-filter-expand="FilterValues-{{ section.id }}-{{ forloop.index }}" aria-expanded="false">See more</button>{% endif %}
                    {% when 'price_range' %}<div class="shop-filters__price-range"><label for="FilterMin-{{ section.id }}">Min</label><input id="FilterMin-{{ section.id }}" class="shop-filters__price-input" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}" type="number" min="0" step="1" placeholder="0" onchange="this.form.submit()"><label for="FilterMax-{{ section.id }}">Max</label><input id="FilterMax-{{ section.id }}" class="shop-filters__price-input" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}" type="number" min="0" step="1" placeholder="Any" onchange="this.form.submit()"></div>
                  {% endcase %}
                </fieldset>
              {% endunless %}
            {% endfor %}
            <div class="shop-filters__actions"><a class="shop-filters__clear" href="{{ collection.url }}">Clear all</a></div>
          </form></div>
        {% endif %}
        <div class="shop-view__catalog-main"><div id="ProductGrid-{{ section.id }}" class="shop-view__grid">{% assign available_products = 0 %}{% for product in collection.products %}{% if product.available %}{% assign available_products = available_products | plus: 1 %}{% render 'product-card', product: product %}{% endif %}{% endfor %}{% if available_products == 0 %}<p>No products found.</p>{% endif %}</div></div>
      </div>
      {% if paginate.pages > 1 %}<nav class="shop-view__pagination" data-product-pagination aria-label="Shop pages"><div class="shop-view__pagination-controls">{% if paginate.previous %}<a class="shop-view__pagination-link shop-view__pagination-link--control" href="{{ paginate.previous.url }}">Back</a>{% else %}<span class="shop-view__pagination-link shop-view__pagination-link--control is-disabled" aria-disabled="true">Back</span>{% endif %}<div class="shop-view__pagination-pages">{% for part in paginate.parts %}{% if part.is_link %}<a class="shop-view__pagination-link" href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == '&hellip;' %}<span class="shop-view__pagination-ellipsis" aria-hidden="true">…</span>{% else %}<span class="shop-view__pagination-link is-current" aria-current="page">{{ part.title }}</span>{% endif %}{% endfor %}</div>{% if paginate.next %}<a class="shop-view__pagination-link shop-view__pagination-link--control" href="{{ paginate.next.url }}">Next</a>{% else %}<span class="shop-view__pagination-link shop-view__pagination-link--control is-disabled" aria-disabled="true">Next</span>{% endif %}</div></nav>{% endif %}
    </div></div></div>
  </section>
{%- endpaginate -%}
{% schema %}
{"name":"Product grid","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":1,"default":28},{"type":"checkbox","id":"enable_filtering","label":"Enable filters","default":true}]}
{% endschema %}
