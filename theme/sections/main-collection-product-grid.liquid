{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="shop-page"><div class="shop-page__container"><div class="shop-view shop-view--3"><div class="shop-view__content">
    <div class="shop-view__category-strip"><div class="shop-view__category-block shop-view__category-block--pink">New Arrivals</div><div class="shop-view__category-block shop-view__category-block--blue">Best Sellers</div><div class="shop-view__category-block shop-view__category-block--yellow">On Sale</div><div class="shop-view__category-block shop-view__category-block--green">Gift Sets</div></div>
    {% assign result_start = paginate.current_offset | plus: 1 %}{% assign result_end = paginate.current_offset | plus: collection.products.size %}{% if paginate.items == 0 %}{% assign result_start = 0 %}{% assign result_end = 0 %}{% endif %}{% assign catalog_total = collection.all_products_count | default: collection.products_count %}
    <header class="shop-view__catalog-toolbar"><p class="shop-view__results-count" aria-live="polite">Showing {{ result_start }}–{{ result_end }} of {{ paginate.items }} products ({{ catalog_total }} total)</p><h1 class="visually-hidden">{{ collection.title | escape }}</h1></header>
    <div class="shop-view__main-layout">
      {% if section.settings.enable_filtering and collection.filters.size > 0 %}
      <div class="shop-filters-panel" data-filter-panel><button class="shop-filters__toggle" type="button" aria-expanded="false" aria-controls="ShopFilters-{{ section.id }}"><span class="shop-filters__toggle-text">Filters</span><span class="shop-filters__toggle-icons" aria-hidden="true"><i class="fa-solid fa-bars shop-filters__icon-bars"></i><i class="fa-solid fa-xmark shop-filters__icon-close"></i></span></button><form id="ShopFilters-{{ section.id }}" class="shop-filters" action="{{ collection.url }}" method="get">
        <h2 class="shop-filters__title">Filter by:</h2>
        {% for filter in collection.filters %}{% unless filter.label == 'Availability' %}
          <fieldset class="shop-filters__group"><legend class="shop-filters__legend">{% case filter.label %}{% when 'Vendor' %}Brand{% when 'Product type' %}Categories{% when 'Availability' %}Stock status{% else %}{{ filter.label | escape }}{% endcase %}</legend>
          {% case filter.type %}
          {% when 'boolean', 'list' %}<select class="shop-filters__select" name="{{ filter.values.first.param_name }}" multiple size="{% if filter.values.size < 6 %}{{ filter.values.size }}{% else %}6{% endif %}" aria-label="{{ filter.label | escape }}">{% for value in filter.values %}<option value="{{ value.value }}" {% if value.active %}selected{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</option>{% endfor %}</select>
          {% when 'price_range' %}<div class="shop-filters__price-range"><label for="FilterMin-{{ section.id }}">Min</label><input id="FilterMin-{{ section.id }}" class="shop-filters__select shop-filters__select--single" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}" type="number" min="0" step="1" placeholder="0"><label for="FilterMax-{{ section.id }}">Max</label><input id="FilterMax-{{ section.id }}" class="shop-filters__select shop-filters__select--single" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}" type="number" min="0" step="1" placeholder="Any"></div>
          {% endcase %}</fieldset>{% endunless %}
        {% endfor %}<div class="shop-filters__actions"><button class="shop-filters__apply" type="submit">Apply filters</button><a class="shop-filters__clear" href="{{ collection.url }}">Clear all</a></div>
      </form></div>{% endif %}
      <div class="shop-view__catalog-main"><div class="shop-view__grid">{% assign available_products = 0 %}{% for product in collection.products %}{% if product.available %}{% assign available_products = available_products | plus: 1 %}{% render 'product-card', product: product %}{% endif %}{% endfor %}{% if available_products == 0 %}<p>No products found.</p>{% endif %}</div></div>
    </div>
    </div>{% if paginate.pages > 1 %}<nav class="shop-view__pagination" aria-label="Shop pages"><div class="shop-view__pagination-controls">{% if paginate.previous %}<a class="shop-view__pagination-link shop-view__pagination-link--control" href="{{ paginate.previous.url }}">Back</a>{% else %}<span class="shop-view__pagination-link shop-view__pagination-link--control is-disabled" aria-disabled="true">Back</span>{% endif %}<div class="shop-view__pagination-pages">{% for part in paginate.parts %}{% if part.is_link %}<a class="shop-view__pagination-link" href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == '&hellip;' %}<span class="shop-view__pagination-ellipsis" aria-hidden="true">…</span>{% else %}<span class="shop-view__pagination-link is-current" aria-current="page">{{ part.title }}</span>{% endif %}{% endfor %}</div>{% if paginate.next %}<a class="shop-view__pagination-link shop-view__pagination-link--control" href="{{ paginate.next.url }}">Next</a>{% else %}<span class="shop-view__pagination-link shop-view__pagination-link--control is-disabled" aria-disabled="true">Next</span>{% endif %}</div></nav>{% endif %}</div></div></div></section>
{%- endpaginate -%}
{% schema %}
{"name":"Product grid","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":4,"default":20},{"type":"checkbox","id":"enable_filtering","label":"Enable filters","default":true}]}
{% endschema %}
