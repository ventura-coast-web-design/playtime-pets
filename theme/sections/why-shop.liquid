<section class="why-shop" aria-label="Why shop with us"><div class="why-shop__inner"><h2 class="why-shop__title">{{ section.settings.heading | escape }}</h2><ul class="why-shop__list">{% for block in section.blocks %}<li class="why-shop__item" {{ block.shopify_attributes }}><span class="why-shop__icon" aria-hidden="true">{% case forloop.index %}{% when 1 %}<i class="fa-solid fa-truck"></i>{% when 2 %}<i class="fa-solid fa-arrow-rotate-left"></i>{% when 3 %}<i class="fa-solid fa-shield"></i>{% else %}<i class="fa-solid fa-leaf"></i>{% endcase %}</span><span class="why-shop__label">{{ block.settings.text | escape }}</span></li>{% endfor %}</ul></div></section>
{% schema %}{"name":"Why shop with us","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why shop with us"}],"blocks":[{"type":"reason","name":"Reason","settings":[{"type":"text","id":"text","label":"Text","default":"Fast Shipping"}]}],"max_blocks":4,"presets":[{"name":"Why shop with us","blocks":[{"type":"reason","settings":{"text":"Fast Shipping"}},{"type":"reason","settings":{"text":"Easy returns within 30 days"}},{"type":"reason","settings":{"text":"Safe, pet-friendly materials"}},{"type":"reason","settings":{"text":"Small business care and quality you can trust"}}]}]}{% endschema %}
