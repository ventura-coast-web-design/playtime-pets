{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="shop-item-show shop-item-show--accent-{{ product.id | modulo: 6 }}"><div class="shop-item-show__container">
  <nav class="shop-item-show__breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span class="shop-item-show__breadcrumb-sep">/</span><a href="{{ routes.all_products_collection_url }}">Shop</a><span class="shop-item-show__breadcrumb-sep">/</span><span class="shop-item-show__breadcrumb-current">{{ product.title | escape }}</span></nav>
  <div class="shop-item-show__layout"><div class="shop-item-show__gallery js-product-gallery" {% if product.images.size > 1 %}tabindex="0"{% endif %}>
    <div class="shop-item-show__image-frame">{% if product.images.size > 1 %}<button class="shop-item-show__gallery-nav shop-item-show__gallery-nav--prev" type="button" aria-label="Previous product image">‹</button><button class="shop-item-show__gallery-nav shop-item-show__gallery-nav--next" type="button" aria-label="Next product image">›</button>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'shop-item-show__image js-product-gallery-main', widths: '400,600,800,1200', alt: product.title }}{% endif %}{% if product.compare_at_price_max > product.price %}<span class="shop-item-show__sale-badge">Sale</span>{% endif %}</div>
    {% if product.images.size > 1 %}<div class="shop-item-show__thumbs" role="tablist">{% for image in product.images %}<button class="shop-item-show__thumb{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>{% endfor %}</div>{% endif %}
  </div><div class="shop-item-show__details"><p class="shop-item-show__eyebrow">{{ product.vendor | default: 'SHOP' }}</p><h1 class="shop-item-show__title">{{ product.title | escape }}</h1><div class="shop-item-show__rating-row">{% if product.metafields.reviews.rating.value != blank %}<span class="shop-item-show__rating" aria-label="Customer rating"><span class="shop-item-show__rating-icon">★</span><span class="shop-item-show__rating-value">{{ product.metafields.reviews.rating.value.rating }}</span><span class="shop-item-show__rating-max">/ 5</span></span>{% endif %}<span class="shop-item-show__stock {% if current_variant.available %}shop-item-show__stock--in{% else %}shop-item-show__stock--out{% endif %}">{% if current_variant.available %}In stock{% else %}Out of stock{% endif %}</span></div><div class="shop-item-show__price-block">{% if product.compare_at_price_max > product.price %}<span class="shop-item-show__price-compare">{{ product.compare_at_price_max | money }}</span>{% endif %}<span class="shop-item-show__price">{{ current_variant.price | money }}</span></div><div class="shop-item-show__about"><h2 class="shop-item-show__about-title">About this product</h2><div class="shop-item-show__description shop-item-show__description--rte">{{ product.description }}</div></div><dl class="shop-item-show__specs"><div class="shop-item-show__spec"><dt>Brand</dt><dd>{{ product.vendor | default: '—' }}</dd></div><div class="shop-item-show__spec"><dt>Type</dt><dd>{{ product.type | default: '—' }}</dd></div>{% if product.metafields.custom.animal_type != blank %}<div class="shop-item-show__spec"><dt>Pet</dt><dd>{{ product.metafields.custom.animal_type.value }}</dd></div>{% endif %}{% if product.metafields.custom.material != blank %}<div class="shop-item-show__spec"><dt>Material</dt><dd>{{ product.metafields.custom.material.value }}</dd></div>{% endif %}</dl>{% if product.tags.size > 0 %}<div class="shop-item-show__tags">{% for tag in product.tags %}<span class="shop-item-show__tag">{{ tag | escape }}</span>{% endfor %}</div>{% endif %}
    {% form 'product', product %}<div class="shop-item-show__actions">{% if product.has_only_default_variant == false %}<label class="visually-hidden" for="Variant-{{ section.id }}">Options</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input name="id" type="hidden" value="{{ current_variant.id }}">{% endif %}<label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1"><button class="shop-item-show__btn shop-item-show__btn--primary shop-item-show__btn--accent" type="submit" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button><a class="shop-item-show__btn shop-item-show__btn--secondary" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% endform %}<p class="shop-item-show__note">30-day returns</p>
  </div></div><section class="shop-item-show__extras" aria-label="Policies and offers"><div class="shop-item-show__policy-list"><article class="shop-item-show__policy"><h2 class="shop-item-show__policy-title">Fast shipping</h2><p class="shop-item-show__policy-text">Orders are packed with care and sent quickly.</p></article><article class="shop-item-show__policy"><h2 class="shop-item-show__policy-title">30-day returns</h2><p class="shop-item-show__policy-text">Hassle-free returns when a toy is not the right fit.</p></article><article class="shop-item-show__policy"><h2 class="shop-item-show__policy-title">Happy pets</h2><p class="shop-item-show__policy-text">We’re here if you have questions before or after your order.</p></article></div><p class="shop-item-show__bundle-offer">10% off when you buy 3 toys or more.</p></section></div></section>
{% schema %}{"name":"Product information","settings":[]}{% endschema %}
