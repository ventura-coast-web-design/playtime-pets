<header class="site-header">
  <div class="site-header__promo"><div class="site-header__promo-inner"><ul class="site-header__promo-list"><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i> Free Shipping</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip site-header__promo-chip--deal"><i class="fa-solid fa-percent" aria-hidden="true"></i> 10% off when you order 3 items or more!</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-tags" aria-hidden="true"></i> Competitive Prices</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-heart" aria-hidden="true"></i> Unbeatable Service</span></li></ul><ul class="site-header__promo-list site-header__promo-list--clone" aria-hidden="true"><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-truck-fast"></i> Free Shipping</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip site-header__promo-chip--deal"><i class="fa-solid fa-percent"></i> 10% off when you order 3 items or more!</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-tags"></i> Competitive Prices</span></li><li class="site-header__promo-item"><span class="site-header__promo-chip"><i class="fa-solid fa-heart"></i> Unbeatable Service</span></li></ul></div></div>
  <div class="site-header__main"><div class="site-header__main-inner">
    <a href="{{ routes.root_url }}" class="site-header__perks" aria-label="{{ shop.name }} home"></a>
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} home"><span class="site-header__logo-main">{% if settings.logo != blank %}{{ settings.logo | image_url: width: settings.logo_width | image_tag: alt: shop.name }}{% else %}<img src="{{ 'color-logo.png' | asset_url }}" alt="{{ shop.name }}" width="180" height="74">{% endif %}</span></a>
    <div class="site-header__actions"><a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart-link" aria-label="Shopping cart"><i class="fa-solid fa-shopping-cart" aria-hidden="true"></i><span class="site-header__cart-badge" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></a></div>
  </div></div>
</header>
{% schema %}
{"name":"Header","settings":[]}
{% endschema %}
