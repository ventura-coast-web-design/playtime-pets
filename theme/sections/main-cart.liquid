<section class="cart-page"><div class="cart-page__container"><nav class="cart-page__breadcrumb"><a href="{{ routes.root_url }}">Home</a><span class="cart-page__breadcrumb-sep">/</span><a href="{{ routes.all_products_collection_url }}">Shop</a><span class="cart-page__breadcrumb-sep">/</span><span class="cart-page__breadcrumb-current">Cart</span></nav><header class="cart-page__head"><h1 class="cart-page__title">Your cart</h1><p class="cart-page__subtitle">Treats, toys, and tail wags — review your picks before checkout.</p></header><div class="cart-page__strip"><div class="cart-page__strip-block cart-page__strip-block--pink">Satisfaction Guaranteed</div><div class="cart-page__strip-block cart-page__strip-block--blue">Fast Shipping</div><div class="cart-page__strip-block cart-page__strip-block--teal">30-day returns</div></div>
{% if cart.item_count == 0 %}<div class="cart-page__empty"><h2 class="cart-page__empty-title">Your cart is waiting</h2><p class="cart-page__empty-text">Add something fun from the shop — your pet will thank you.</p><a href="{{ routes.all_products_collection_url }}" class="cart-page__empty-cta">Browse the shop</a></div>
{% else %}{% form 'cart', cart %}<div class="cart-page__layout"><div class="cart-page__lines"><h2 class="cart-page__lines-title">Items</h2><ul class="cart-page__line-list">{% for item in cart.items %}<li class="cart-page__line cart-page__line--accent-{{ forloop.index0 | modulo: 6 }}"><a class="cart-page__line-thumb" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div class="cart-page__line-body"><h3 class="cart-page__line-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>{% unless item.variant.title == 'Default Title' %}<p class="cart-page__line-meta">{{ item.variant.title }}</p>{% endunless %}<div class="cart-page__line-price-row"><span class="cart-page__line-unit">{{ item.final_price | money }}</span>{% if item.original_price > item.final_price %}<span class="cart-page__line-compare">{{ item.original_price | money }}</span>{% endif %}</div></div><div class="cart-page__line-controls"><div class="cart-page__qty"><button class="cart-page__qty-btn" data-quantity-step="-1" type="button" aria-label="Decrease quantity">−</button><input class="cart-page__qty-input" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><button class="cart-page__qty-btn" data-quantity-step="1" type="button" aria-label="Increase quantity">+</button></div><a class="cart-page__remove" href="{{ item.url_to_remove }}">Remove</a><span class="cart-page__line-total">{{ item.final_line_price | money }}</span></div></li>{% endfor %}</ul></div><aside class="cart-page__summary"><h2 class="cart-page__summary-title">Order summary</h2><div class="cart-page__summary-row"><span>Subtotal</span><span>{{ cart.original_total_price | money }}</span></div>{% if cart.total_discount > 0 %}<div class="cart-page__summary-row cart-page__summary-row--discount"><span>{% if cart.item_count >= 3 %}Bundle discount (10%){% else %}Discount{% endif %}</span><span>−{{ cart.total_discount | money }}</span></div><p class="cart-page__summary-note cart-page__summary-note--success">10% off applied — you ordered {{ cart.item_count }} items.</p>{% elsif cart.item_count < 3 %}{% assign items_needed = 3 | minus: cart.item_count %}<p class="cart-page__summary-note">Add {{ items_needed }} more item{% if items_needed != 1 %}s{% endif %} to receive 10% off.</p>{% endif %}<div class="cart-page__summary-row cart-page__summary-row--emphasis"><span>Estimated total</span><span>{{ cart.total_price | money }}</span></div><p class="cart-page__summary-note">Shipping and taxes are calculated at checkout.</p><button class="cart-page__checkout" name="checkout" type="submit">Checkout</button><button class="cart-page__continue" name="update" type="submit">Update cart</button></aside></div>{% endform %}{% endif %}<section class="cart-page__extras" aria-label="Policies and offers"><div class="cart-page__policy-list"><article class="cart-page__policy"><h2 class="cart-page__policy-title">California Prop 65</h2><p class="cart-page__policy-text"><strong>WARNING:</strong> This product can expose you to chemicals known to the State of California to cause cancer and birth defects or other reproductive harm. For more information go to <a href="https://www.P65Warnings.ca.gov" target="_blank" rel="noopener noreferrer">www.P65Warnings.ca.gov</a>.</p></article><article class="cart-page__policy"><h2 class="cart-page__policy-title">Return Policy</h2><p class="cart-page__policy-text">We inspect every item before shipping including the squeakers, stitching and overall appearance.</p><p class="cart-page__policy-text">We offer free returns if what we shipped is not what you ordered.</p><p class="cart-page__policy-text">Returned items must be unused in their original packaging.</p><p class="cart-page__policy-text">A toy’s longevity varies depending on the pet and its level of use. We cannot be responsible for how a pet plays with its new toy. “My dog tore it to shreds” is not our responsibility and is not a valid return.</p></article><article class="cart-page__policy"><h2 class="cart-page__policy-title">Shipping Policy</h2><p class="cart-page__policy-text">We always ship next day when possible.</p><p class="cart-page__policy-text">Expect items to take 3–5 business days to arrive.</p><p class="cart-page__policy-text">There can be unexpected delays due to weather or carrier mistakes.</p><p class="cart-page__policy-text">You can track your item and/or contact us for questions.</p><p class="cart-page__policy-text">If your item is lost, with no movement for 30 days, we will replace or refund it.</p><p class="cart-page__policy-text">If your item says it is delivered, it is delivered. From there you must contact your local post office.</p></article></div><p class="cart-page__bundle-offer">10% off when you buy 3 toys or more.</p></section></div></section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
