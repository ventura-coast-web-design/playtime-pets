<article class="shop-view__product-card shop-view__product-card--color-{{ product.id | modulo: 6 }}" data-shop-product>
  <div class="shop-view__product-media"><div class="shop-view__product-image"><a href="{{ product.url }}" class="shop-view__product-link-fill" aria-label="View {{ product.title | escape }}"></a>
    {% for image in product.images limit: 4 %}{% if forloop.first %}{{ image | image_url: width: 700 | image_tag: class: 'shop-view__card-slide is-active', loading: 'lazy', widths: '240,360,540,700', alt: product.title }}{% else %}{{ image | image_url: width: 700 | image_tag: class: 'shop-view__card-slide', loading: 'lazy', widths: '240,360,540,700', alt: '' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endfor %}
    {% if product.compare_at_price_max > product.price %}<span class="shop-view__sale-badge">Sale</span>{% endif %}</div>
    {% if product.images.size > 1 %}<button type="button" class="shop-view__card-nav shop-view__card-nav--prev" aria-label="Previous product image">‹</button><button type="button" class="shop-view__card-nav shop-view__card-nav--next" aria-label="Next product image">›</button>{% endif %}
  </div><div class="shop-view__product-info"><a href="{{ product.url }}" class="shop-view__product-link-title"><h3 class="shop-view__product-title">{{ product.title | escape }}</h3></a><div class="shop-view__product-price-row"><div class="shop-view__product-price">{% if product.compare_at_price_max > product.price %}<span class="shop-view__price-original">{{ product.compare_at_price_max | money }}</span>{% endif %}<span class="shop-view__price-current">{{ product.price | money }}</span></div>
  {% if product.available %}{% form 'product', product, class: 'quick-add-form shop-view__card-cart' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="shop-view__add-btn" type="submit">Add to cart</button>{% endform %}{% else %}<span class="shop-view__add-btn" aria-disabled="true">Sold out</span>{% endif %}</div></div>
</article>
