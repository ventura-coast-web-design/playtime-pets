{%- liquid
  assign target = product.selected_or_first_available_variant | default: product
  assign compare_at_price = target.compare_at_price
-%}
<div class="price">
  {% if compare_at_price > target.price %}<s class="price__compare">{{ compare_at_price | money }}</s>{% endif %}
  <span class="price__current">{{ target.price | money }}</span>
</div>
