<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.accent_color }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>.home-page__section--one-stop { background-image: url('{{ 'one-stop-shop.jpg' | asset_url }}'); }</style>
    <script src="https://kit.fontawesome.com/b96b0b2690.js" crossorigin="anonymous"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'shop-card-gallery.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'shop-item-gallery.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="template-{{ template.name | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
  </body>
</html>
