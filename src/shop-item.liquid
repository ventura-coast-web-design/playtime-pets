---
pagination:
  data: products
  size: 1
  alias: product
permalink: "shop/{{ product.handle }}/index.html"
layout: base
title: Shop
---

{% comment %} Map animal code to friendly label (matches shop filter language) {% endcomment %}
{% if product.animal == 'both' %}
  {% assign animal_label = 'Dogs & cats' %}
{% elsif product.animal == 'dog' %}
  {% assign animal_label = 'Dog' %}
{% elsif product.animal == 'cat' %}
  {% assign animal_label = 'Cat' %}
{% else %}
  {% assign animal_label = '—' %}
{% endif %}

{% if product.breedSizeLabel and product.breedSizeLabel != '—' %}
  {% assign breed_label = product.breedSizeLabel %}
{% elsif product.breedSize == 'all' %}
  {% assign breed_label = 'All sizes' %}
{% elsif product.breedSize %}
  {% assign breed_label = product.breedSize | capitalize %}
{% else %}
  {% assign breed_label = '—' %}
{% endif %}

{% comment %} Same 6 accent colors as shop grid cards (shop-view__product-card--color-*) {% endcomment %}
{% assign accent_index = product.accentIndex | default: 0 %}

<div class="shop-item-show shop-item-show--accent-{{ accent_index }}">
  <div class="shop-item-show__container">
    <nav class="shop-item-show__breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="shop-item-show__breadcrumb-sep" aria-hidden="true">/</span>
      <a href="/shop/">Shop</a>
      <span class="shop-item-show__breadcrumb-sep" aria-hidden="true">/</span>
      <span class="shop-item-show__breadcrumb-current">{{ product.title }}</span>
    </nav>

    <div class="shop-item-show__layout">
      <div
        class="shop-item-show__gallery js-product-gallery"
        {% if product.images.size > 1 %}tabindex="0"{% endif %}
        aria-label="{% if product.images.size > 1 %}Product photos. Use arrow keys or buttons to change image.{% else %}{{ product.title }} photo{% endif %}"
      >
        <div class="shop-item-show__image-frame">
          {% if product.images.size > 1 %}
          <button type="button" class="shop-item-show__gallery-nav shop-item-show__gallery-nav--prev" aria-label="Previous image">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <button type="button" class="shop-item-show__gallery-nav shop-item-show__gallery-nav--next" aria-label="Next image">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
          {% endif %}
          <img
            class="shop-item-show__image js-product-gallery-main"
            src="{{ product.image }}"
            alt="{{ product.title }}"
            width="800"
            height="800"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          >
          {% if product.comparePrice %}
          <span class="shop-item-show__sale-badge">Sale</span>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
        <div class="shop-item-show__thumbs" role="tablist" aria-label="Product thumbnails">
          {% for url in product.images %}
          <button
            type="button"
            class="shop-item-show__thumb{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Image {{ forloop.index }} of {{ product.images.size }}"
            data-gallery-index="{{ forloop.index0 }}"
          >
            <img src="{{ url }}" alt="" width="88" height="88" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
          </button>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="shop-item-show__details">
        <p class="shop-item-show__eyebrow">
          {% if product.collections.size > 0 %}
            {{ product.collections | map: "title" | join: ", " | upcase }}
          {% else %}
            SHOP
          {% endif %}
        </p>
        <h1 class="shop-item-show__title">{{ product.title }}</h1>

        <div class="shop-item-show__rating-row">
          <span class="shop-item-show__rating" aria-label="Customer rating {{ product.rating }} out of 5">
            <i class="fa-solid fa-star shop-item-show__rating-icon" aria-hidden="true"></i>
            <span class="shop-item-show__rating-value">{{ product.rating }}</span>
            <span class="shop-item-show__rating-max">/ 5</span>
          </span>
          {% if product.inStock %}
          <span class="shop-item-show__stock shop-item-show__stock--in">In stock</span>
          {% else %}
          <span class="shop-item-show__stock shop-item-show__stock--out">Out of stock</span>
          {% endif %}
        </div>

        <div class="shop-item-show__price-block">
          {% if product.comparePrice %}
          <span class="shop-item-show__price-compare">${{ product.comparePrice }}</span>
          {% endif %}
          <span class="shop-item-show__price">${{ product.price }}</span>
        </div>

        {% if product.descriptionHtml != blank %}
        <div class="shop-item-show__about">
          <h2 class="shop-item-show__about-title">About this product</h2>
          <div class="shop-item-show__description shop-item-show__description--rte">
            {{ product.descriptionHtml }}
          </div>
        </div>
        {% endif %}

        <dl class="shop-item-show__specs">
          <div class="shop-item-show__spec">
            <dt>Brand</dt>
            <dd>{{ product.brand }}</dd>
          </div>
          <div class="shop-item-show__spec">
            <dt>Pet</dt>
            <dd>{{ animal_label }}</dd>
          </div>
          <div class="shop-item-show__spec">
            <dt>Breed size</dt>
            <dd>{{ breed_label }}</dd>
          </div>
          <div class="shop-item-show__spec">
            <dt>Material</dt>
            <dd>{{ product.material }}</dd>
          </div>
        </dl>

        {% assign tag_count = product.tags | size %}
        {% if tag_count > 0 %}
        <div class="shop-item-show__tags">
          {% for tag in product.tags %}
          <span class="shop-item-show__tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}

        <div class="shop-item-show__actions">
          <button
            type="button"
            class="shop-item-show__btn shop-item-show__btn--primary shop-item-show__btn--accent js-add-to-cart"
            data-product-handle="{{ product.handle }}"
            {% if product.variantId %}data-variant-id="{{ product.variantId }}"{% endif %}
            data-product-id="{{ product.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price }}"
            data-product-image="{{ product.image }}"
            {% if product.comparePrice %}data-product-compare-price="{{ product.comparePrice }}"{% endif %}
          >
            Add to cart
          </button>
          <a class="shop-item-show__btn shop-item-show__btn--secondary" href="/shop/">Continue shopping</a>
        </div>

        <p class="shop-item-show__note">30-day returns</p>
      </div>
    </div>

    <section class="shop-item-show__extras" aria-label="Policies and offers">
      <div class="shop-item-show__policy-list">
        <article class="shop-item-show__policy">
          <h2 class="shop-item-show__policy-title">California Prop 65</h2>
          <p class="shop-item-show__policy-text"><strong>WARNING:</strong> This product can expose you to chemicals known to the State of California to cause cancer and birth defects or other reproductive harm. For more information go to <a href="https://www.P65Warnings.ca.gov" target="_blank" rel="noopener noreferrer">www.P65Warnings.ca.gov</a>.</p>
        </article>

        <article class="shop-item-show__policy">
          <h2 class="shop-item-show__policy-title">Return Policy</h2>
          <p class="shop-item-show__policy-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum tortor quam, feugiat vitae, ultricies eget, tempor sit amet, ante.</p>
        </article>

        <article class="shop-item-show__policy">
          <h2 class="shop-item-show__policy-title">Shipping Policy</h2>
          <p class="shop-item-show__policy-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa quis enim. Donec pede justo, fringilla vel, aliquet nec, vulputate eget, arcu.</p>
        </article>
      </div>

      <p class="shop-item-show__bundle-offer">10% off when you buy 3 toys or more.</p>
    </section>
  </div>
</div>

{% if product.images.size > 1 %}
<script src="/assets/js/shop-item-gallery.js" defer></script>
{% endif %}
