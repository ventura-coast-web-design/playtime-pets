<header class="site-header">
  <div class="site-header__promo">
    <p class="site-header__promo-text">Find the Perfect Gift for Your Furry Friend! <i class="fa-solid fa-gift" aria-hidden="true"></i></p>
  </div>
  <div class="site-header__main">
    <div class="site-header__main-inner">
      <a href="/" class="site-header__perks"></a>
      <a href="/" class="site-header__logo">
        <span class="site-header__logo-main"><img src="/assets/images/color-logo.png" alt="Playtime Pets" /></span>
      </a>
      <div class="site-header__actions">
        <a href="/cart" class="site-header__icon site-header__cart-link" aria-label="Shopping cart">
          <i class="fa-solid fa-shopping-cart" aria-hidden="true"></i>
          <span class="site-header__cart-badge" id="header-cart-badge" hidden>0</span>
        </a>
      </div>
    </div>
  </div>
  {% if home %}
  <nav class="site-header__nav site-header__nav--cascade" aria-label="Shop by category">
    <div class="site-header__nav-inner">
      <ul class="site-header__nav-root">
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-dog-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-dog-panel"
          >
            Dog
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel site-header__nav-panel--rich" id="nav-dog-panel" role="region" aria-labelledby="nav-dog-trigger">
            <div class="nav-dropdown">
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Toys &amp; play</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/play">Chew &amp; durable toys</a></li>
                  <li><a href="/collections/play">Plush &amp; squeaky</a></li>
                  <li><a href="/collections/play">Fetch, balls &amp; tug</a></li>
                  <li><a href="/collections/play">Puzzle &amp; treat toys</a></li>
                  <li><a href="/collections/play">Puppy toys</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Out &amp; about</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/walk">Walk — leads &amp; harnesses</a></li>
                  <li><a href="/collections/wear">Wear — coats &amp; gear</a></li>
                  <li><a href="/collections/walk">Travel &amp; safety</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Cozy at home</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/sleep">Beds &amp; crates</a></li>
                  <li><a href="/shop/">Bowls &amp; feeders</a></li>
                  <li><a href="/shop/">Grooming</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group nav-dropdown__group--footer">
                <a href="/shop/" class="nav-dropdown__all">Shop all dog</a>
              </div>
            </div>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-cat-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-cat-panel"
          >
            Cat
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel site-header__nav-panel--rich" id="nav-cat-panel" role="region" aria-labelledby="nav-cat-trigger">
            <div class="nav-dropdown">
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Toys &amp; play</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/play">Wands &amp; teasers</a></li>
                  <li><a href="/collections/play">Catnip &amp; chase toys</a></li>
                  <li><a href="/collections/play">Scratchers &amp; posts</a></li>
                  <li><a href="/collections/play">Puzzle &amp; treat toys</a></li>
                  <li><a href="/collections/play">Kitten toys</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Roam &amp; relax</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/walk">Collars &amp; harnesses</a></li>
                  <li><a href="/collections/wear">Apparel</a></li>
                  <li><a href="/collections/sleep">Beds &amp; hideaways</a></li>
                  <li><a href="/shop/">Carriers &amp; travel</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">Everyday care</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/shop/">Bowls &amp; fountains</a></li>
                  <li><a href="/shop/">Litter &amp; trays</a></li>
                  <li><a href="/shop/">Grooming</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group nav-dropdown__group--footer">
                <a href="/shop/" class="nav-dropdown__all">Shop all cat</a>
              </div>
            </div>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-seasonal-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-seasonal-panel"
          >
            Seasonal
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel site-header__nav-panel--rich" id="nav-seasonal-panel" role="region" aria-labelledby="nav-seasonal-trigger">
            <div class="nav-dropdown nav-dropdown--seasonal">
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">This season</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/new">New arrivals</a></li>
                  <li><a href="/collections/bundles">Gift bundles</a></li>
                  <li><a href="/shop/">Holiday picks</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group">
                <p class="nav-dropdown__label">By pet</p>
                <ul class="nav-dropdown__list">
                  <li><a href="/collections/new">For dogs</a></li>
                  <li><a href="/collections/new">For cats</a></li>
                </ul>
              </div>
              <div class="nav-dropdown__group nav-dropdown__group--footer">
                <a href="/shop/" class="nav-dropdown__all">Browse seasonal shop</a>
              </div>
            </div>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sub site-header__nav-branch--sale-dropdown">
          <button
            type="button"
            class="site-header__nav-trigger site-header__nav-trigger--sale"
            id="nav-sale-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-sale-panel"
          >
            Sale
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel site-header__nav-panel--rich" id="nav-sale-panel" role="region" aria-labelledby="nav-sale-trigger">
            <ul class="site-header__nav-sub">
              <li><a href="/sale">All sale items</a></li>
              <li><a href="/collections/bundles">Bundles on sale</a></li>
              <li><a href="/collections/new">Recently marked down</a></li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </nav>
  {% endif %}
</header>
