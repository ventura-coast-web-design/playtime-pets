<header class="site-header">
  <div class="site-header__promo">
    {% capture promo_items %}
      <li class="site-header__promo-item">
        <span class="site-header__promo-chip">
          <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
          Free Shipping
        </span>
      </li>
      <li class="site-header__promo-item">
        <span class="site-header__promo-chip site-header__promo-chip--deal">
          <i class="fa-solid fa-percent" aria-hidden="true"></i>
          10% off when you order 3 items or more!
        </span>
      </li>
      <li class="site-header__promo-item">
        <span class="site-header__promo-chip">
          <i class="fa-solid fa-tags" aria-hidden="true"></i>
          Competitive Prices
        </span>
      </li>
      <li class="site-header__promo-item">
        <span class="site-header__promo-chip">
          <i class="fa-solid fa-heart" aria-hidden="true"></i>
          Unbeatable Service
        </span>
      </li>
    {% endcapture %}
    <div class="site-header__promo-inner">
      <ul class="site-header__promo-list">
        {{ promo_items }}
      </ul>
      <ul class="site-header__promo-list site-header__promo-list--clone" aria-hidden="true">
        {{ promo_items }}
      </ul>
    </div>
  </div>
  <div class="site-header__main">
    <div class="site-header__main-inner">
      <a href="/" class="site-header__perks"></a>
      <a href="/" class="site-header__logo">
        <span class="site-header__logo-main"><img src="/assets/images/color-logo.png" alt="Playtime Pets" /></span>
      </a>
      <div class="site-header__actions">
        <a href="/cart" class="site-header__icon site-header__cart-link" aria-label="Shopping cart">
          <i class="fa-solid fa-shopping-cart" aria-hidden="true"></i>
          <span class="site-header__cart-badge" id="header-cart-badge" hidden>0</span>
        </a>
      </div>
    </div>
  </div>

</header>
