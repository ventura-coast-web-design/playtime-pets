<header class="site-header">
  <div class="site-header__promo">
    <p class="site-header__promo-text">Find the Perfect Gift for Your Furry Friend! <i class="fa-solid fa-gift" aria-hidden="true"></i></p>
  </div>
  <div class="site-header__main">
    <div class="site-header__main-inner">
      <a href="/" class="site-header__perks"></a>
      <a href="/" class="site-header__logo">
        <span class="site-header__logo-main"><img src="/assets/images/color-logo.png" alt="Playtime Pets" /></span>
      </a>
      <div class="site-header__actions">
        <a href="/cart" class="site-header__icon site-header__cart-link" aria-label="Shopping cart">
          <i class="fa-solid fa-shopping-cart" aria-hidden="true"></i>
          <span class="site-header__cart-badge" id="header-cart-badge" hidden>0</span>
        </a>
      </div>
    </div>
  </div>
  {% if home %}
  <nav class="site-header__nav site-header__nav--cascade" aria-label="Shop by category">
    <div class="site-header__nav-inner">
      <ul class="site-header__nav-root">
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-dog-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-dog-panel"
          >
            Dog
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel" id="nav-dog-panel" role="region" aria-labelledby="nav-dog-trigger">
            <ul class="site-header__nav-sub">
              <li><a href="/shop/">All dog</a></li>
              <li><a href="/collections/walk">Walk</a></li>
              <li><a href="/collections/wear">Wear</a></li>
              <li><a href="/collections/play">Play</a></li>
            </ul>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-cat-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-cat-panel"
          >
            Cat
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel" id="nav-cat-panel" role="region" aria-labelledby="nav-cat-trigger">
            <ul class="site-header__nav-sub">
              <li><a href="/shop/">All cat</a></li>
              <li><a href="/collections/sleep">Sleep</a></li>
              <li><a href="/collections/wear">Wear</a></li>
              <li><a href="/collections/play">Play</a></li>
            </ul>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sub">
          <button
            type="button"
            class="site-header__nav-trigger"
            id="nav-seasonal-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-seasonal-panel"
          >
            Seasonal
            <i class="fa-solid fa-chevron-down site-header__nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="site-header__nav-panel" id="nav-seasonal-panel" role="region" aria-labelledby="nav-seasonal-trigger">
            <ul class="site-header__nav-sub">
              <li><a href="/collections/new">New arrivals</a></li>
              <li><a href="/shop/">Gift ideas</a></li>
            </ul>
          </div>
        </li>
        <li class="site-header__nav-branch site-header__nav-branch--sale">
          <a href="/sale" class="site-header__nav-sale-link">Sale</a>
        </li>
      </ul>
    </div>
  </nav>
  {% endif %}
</header>
