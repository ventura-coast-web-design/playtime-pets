<section class="hero-grid" aria-label="Featured promotions">
  <div class="hero-grid__container">
    <div class="hero-grid__layout">
      <a href="/shop/" class="hero-grid__main">
        <div class="hero-grid__main-bg" aria-hidden="true"></div>
        <div class="hero-grid__main-inner">
          <div class="hero-grid__main-copy">
            <h1 class="hero-grid__main-title">Opening Soon!</h1>
            <p class="hero-grid__main-lede">We're coming soon. Straight from our store to your door.</p>
            <span class="hero-grid__main-cta">Shop now</span>
          </div>
          <div class="hero-grid__main-visual">
              <img
                src="/assets/images/paw-reach.png"
                alt=""
                width="480"
                height="480"
                loading="eager"
                decoding="async"
              />
          </div>
        </div>
      </a>

      <div class="hero-grid__promos" role="list">
        {% for p in heroShowcase.promoSlots %}
          {% if p %}
            <a role="listitem" href="/shop/{{ p.handle }}/" class="hero-grid__promo">
              <div class="hero-grid__promo-top">
                <span class="hero-grid__promo-brand">{{ p.title }}</span>
                <span class="hero-grid__promo-offer">
                  {% if p.comparePrice %}
                    <span class="hero-grid__promo-was">Was ${{ p.comparePrice }}</span>
                    <span class="hero-grid__promo-now">Now ${{ p.price }}</span>
                  {% else %}
                    <span class="hero-grid__promo-now">From ${{ p.price }}</span>
                  {% endif %}
                </span>
              </div>
              <div class="hero-grid__promo-img-wrap">
                <img src="{{ p.image }}" alt="" width="200" height="200" loading="lazy" decoding="async" />
                {% if p.comparePrice %}
                  <span class="hero-grid__promo-badge">Sale</span>
                {% endif %}
              </div>
              <span class="hero-grid__promo-loyalty">
                <i class="fa-solid fa-paw" aria-hidden="true"></i>
              </span>
            </a>
          {% else %}
            <a role="listitem" href="/shop/" class="hero-grid__promo hero-grid__promo--empty">
              <div class="hero-grid__promo-top">
                <span class="hero-grid__promo-brand">Playtime Pets</span>
                <span class="hero-grid__promo-offer"><span class="hero-grid__promo-now">See all products</span></span>
              </div>
              <div class="hero-grid__promo-img-wrap hero-grid__promo-img-wrap--placeholder"></div>
              <span class="hero-grid__promo-loyalty">
                <i class="fa-solid fa-paw" aria-hidden="true"></i>
                Playtime pts
              </span>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hero-grid__categories" role="list">
        {% for tile in heroShowcase.categoryTiles %}
          <a role="listitem" href="{{ tile.href }}" class="hero-grid__category">
            <span class="hero-grid__category-label">{{ tile.label }}</span>
            <span class="hero-grid__category-img-wrap">
              <img
                src="{{ tile.image }}"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
