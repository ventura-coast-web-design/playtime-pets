# Shopify headless (Storefront API) — create a custom app in Shopify Admin → Configure Storefront API.
# Store domain must be the *.myshopify.com hostname (no https://).
# Like the token, it is emitted as domainParts in HTML so the full hostname is not one literal substring in _site.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Must be the "Storefront API access token" (public). NOT the Admin API secret key — that causes UNAUTHORIZED.
# At build time this value is split into chunks in HTML (storefrontTokenParts) so the full string is not one literal
# in _site — secret scanners often flag that even though this token is meant for the browser.
SHOPIFY_STOREFRONT_TOKEN=

# Optional — defaults to 2024-10
# SHOPIFY_STOREFRONT_API_VERSION=2024-10
